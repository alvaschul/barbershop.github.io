{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bb-barber-sync",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bb-barber-sync",
      "database_id": "${D1_ID}",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SYNC_TOKEN": "${SYNC_TOKEN}"
  }
}